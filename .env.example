# Analytics & tracking — all optional, disabled until set
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_META_PIXEL_ID=

# Email delivery for Quote / Contact / Review / Checkout forms (Resend)
# Get an API key at https://resend.com — the sending domain (bbblossoms.com)
# must be verified in Resend before the from: addresses below will deliver.
RESEND_API_KEY=
# Suggested default for all *_NOTIFY_EMAIL vars below: info@bbblossoms.com
QUOTE_NOTIFY_EMAIL=
CONTACT_NOTIFY_EMAIL=
REVIEWS_NOTIFY_EMAIL=
CHECKOUT_NOTIFY_EMAIL=
