{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "bb-blossoms",
	"compatibility_date": "2026-08-21",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			// Backs the OpenNext incremental cache (ISR/prerendered page cache)
			// so prerendered pages are served from R2 instead of re-invoking the
			// Worker on every request. Binding name is fixed by
			// @opennextjs/cloudflare's r2-incremental-cache override — must be
			// exactly this, see node_modules/@opennextjs/cloudflare/dist/api/overrides/incremental-cache/r2-incremental-cache.js
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "bb-blossoms-cache"
		}
	],
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "bb-blossoms"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}